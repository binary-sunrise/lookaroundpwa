{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/pwa/bioActivity/:path*",
      "destination": "/pwa/edit.html"
    },
    {
      "source": "/pwa/settings",
      "destination": "/pwa/settings.html"
    },
    {
      "source": "/pwa/sync",
      "destination": "/pwa/sync.html"
    },
    {
      "source": "/pwa",
      "destination": "/pwa/index.html"
    },
    {
      "source": "/pwa/:path*",
      "destination": "/pwa/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/(sw.js|registerSW.js|manifest.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
